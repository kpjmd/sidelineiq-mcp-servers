# Server Configuration
PORT_FARCASTER=3101
PORT_TWITTER=3102
PORT_WEB=3103
NODE_ENV=development

# Neynar (Farcaster)
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=
SIDELINEIQ_FARCASTER_FID=

# Twitter API v2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# Database (Neon PostgreSQL)
DATABASE_URL=

# MD Review
MD_REVIEW_CONFIDENCE_THRESHOLD=0.75

# Anthropic (Tier 2 content linter — Haiku framing classifier)
# Optional: if unset, the linter falls back to its deterministic regex rules
# and emits a `classifier_unavailable` warning (it never blocks publish on a
# missing key). Set in Railway for the framing classifier to run.
ANTHROPIC_API_KEY=
